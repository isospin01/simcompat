<?xml version="1.0"?>
<robot name="arm6">
  <!-- clean reference arm: rotated inertial frames, full inertia tensors, skewed axes,
       a continuous joint, a prismatic joint and a fixed tool. Every engine should match it. -->
  <link name="base_link"><inertial><origin xyz="0 0 0.05" rpy="0 0 0"/><mass value="4.0"/><inertia ixx="0.0223152372" ixy="-0.00201019807" ixz="-0.00599675616" iyy="0.0186118513" iyz="0.000899696426" izz="0.0259690288"/></inertial><collision><origin xyz="0 0 0.05"/><geometry><box size="0.2 0.2 0.1"/></geometry></collision></link>
  <link name="shoulder"><inertial><origin xyz="0 0.02 0.08" rpy="0.1 0 0.3"/><mass value="2.5"/><inertia ixx="0.00740508673" ixy="0.000805043833" ixz="-0.00217759689" iyy="0.00896360835" iyz="0.00128576015" izz="0.0120802334"/></inertial><collision><origin xyz="0 0 0.08"/><geometry><cylinder radius="0.06" length="0.16"/></geometry></collision></link>
  <link name="upper_arm"><inertial><origin xyz="0.15 0 0.01" rpy="0 0.2 -0.1"/><mass value="2.0"/><inertia ixx="0.0279246124" ixy="0.00217644979" ixz="0.0045354189" iyy="0.0243591096" iyz="0.0023822214" izz="0.024396031"/></inertial><collision><origin xyz="0.15 0 0"/><geometry><box size="0.3 0.07 0.07"/></geometry></collision></link>
  <link name="forearm"><inertial><origin xyz="0.12 0.005 0" rpy="0.3 -0.2 0.5"/><mass value="1.4"/><inertia ixx="0.0147254429" ixy="0.00124796263" ixz="0.00101584387" iyy="0.0137227882" iyz="-8.21995781e-05" izz="0.015732633"/></inertial><collision><origin xyz="0.12 0 0"/><geometry><box size="0.25 0.06 0.06"/></geometry></collision></link>
  <link name="wrist"><inertial><origin xyz="0 0 0.03" rpy="0 0 0.7"/><mass value="0.6"/><inertia ixx="0.00126885413" ixy="-6.73643318e-05" ixz="0.000145223499" iyy="0.00183041832" iyz="-0.000190439755" izz="0.00175731728"/></inertial><collision><origin xyz="0 0 0.03"/><geometry><sphere radius="0.04"/></geometry></collision></link>
  <link name="flange"><inertial><origin xyz="0.02 0 0" rpy="0.5 0.5 0"/><mass value="0.3"/><inertia ixx="0.000388413636" ixy="-1.48750472e-05" ixz="-1.65754744e-06" iyy="0.000365798387" iyz="1.64249769e-05" izz="0.000373079012"/></inertial><collision><origin xyz="0 0 0"/><geometry><cylinder radius="0.03" length="0.02"/></geometry></collision></link>
  <link name="tool"><inertial><origin xyz="0.03 0.01 0" rpy="0 0 0"/><mass value="0.25"/><inertia ixx="0.000374925322" ixy="-1.22383956e-05" ixz="-9.26731936e-05" iyy="0.000274365427" iyz="5.1720935e-05" izz="0.000361892423"/></inertial><collision><origin xyz="0.03 0 0"/><geometry><box size="0.06 0.04 0.02"/></geometry></collision></link>
  <link name="finger"><inertial><origin xyz="0.01 0 0" rpy="0 0 0"/><mass value="0.05"/><inertia ixx="2.07015212e-05" ixy="2.61020659e-06" ixz="-4.52648365e-06" iyy="2.10845759e-05" iyz="-2.82816214e-06" izz="2.05311515e-05"/></inertial><collision><origin xyz="0.01 0 0"/><geometry><box size="0.02 0.01 0.04"/></geometry></collision></link>
  <joint name="shoulder_pan" type="revolute"><parent link="base_link"/><child link="shoulder"/><origin xyz="0 0 0.1" rpy="0 0 0"/><axis xyz="0 0 1"/><limit effort="80" velocity="2.0" lower="-3.0" upper="3.0"/><dynamics damping="0.8"/></joint>
  <joint name="shoulder_lift" type="revolute"><parent link="shoulder"/><child link="upper_arm"/><origin xyz="0 0.03 0.16" rpy="1.5707963 0 0"/><axis xyz="0 0.6 0.8"/><limit effort="80" velocity="2.0" lower="-2.0" upper="2.0"/><dynamics damping="0.5"/></joint>
  <joint name="elbow" type="revolute"><parent link="upper_arm"/><child link="forearm"/><origin xyz="0.3 0 0" rpy="0 0 0.4"/><axis xyz="0 0 1"/><limit effort="40" velocity="3.0" lower="-2.5" upper="2.5"/><dynamics damping="0.3"/></joint>
  <joint name="wrist_tilt" type="revolute"><parent link="forearm"/><child link="wrist"/><origin xyz="0.25 0 0" rpy="0 1.5707963 0"/><axis xyz="1 0 0"/><limit effort="10" velocity="4.0" lower="-2.0" upper="2.0"/><dynamics damping="0.05"/></joint>
  <joint name="wrist_roll" type="continuous"><parent link="wrist"/><child link="flange"/><origin xyz="0 0 0.06" rpy="0 0 0"/><axis xyz="0 0 1"/><limit effort="10" velocity="6.0"/><dynamics damping="0.02"/></joint>
  <joint name="tool_mount" type="fixed"><parent link="flange"/><child link="tool"/><origin xyz="0.01 0 0.02" rpy="0 -0.3 0"/></joint>
  <joint name="finger_slide" type="prismatic"><parent link="tool"/><child link="finger"/><origin xyz="0.06 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/><limit effort="20" velocity="0.2" lower="-0.02" upper="0.03"/><dynamics damping="1.0"/></joint>
</robot>

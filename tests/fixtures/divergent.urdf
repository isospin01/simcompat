<robot name="divergent">
  <!-- Deliberately exercises importer differences: rotated inertial frame, fixed child (fusing),
       a link without <inertial>, joint damping+friction, a continuous joint and a mimic joint. -->
  <link name="base"><inertial><mass value="5"/><inertia ixx="1" iyy="1" izz="1" ixy="0" ixz="0" iyz="0"/></inertial>
    <collision><geometry><box size="0.2 0.2 0.2"/></geometry></collision></link>
  <!-- link with rotated inertial frame (MuJoCo #3559) -->
  <link name="l1"><inertial><origin xyz="0.1 0 0" rpy="0 0 1.5707963267948966"/><mass value="1"/>
      <inertia ixx="0.01" iyy="0.02" izz="0.025" ixy="0" ixz="0" iyz="0"/></inertial>
    <collision><origin xyz="0.1 0 0"/><geometry><box size="0.2 0.05 0.05"/></geometry></collision></link>
  <joint name="j1" type="revolute"><parent link="base"/><child link="l1"/><origin xyz="0 0 0.2" rpy="0.3 0 0"/>
    <axis xyz="0 1 0"/><limit lower="-2" upper="2" effort="10" velocity="3"/><dynamics damping="0.5" friction="0.2"/></joint>
  <link name="l2"><inertial><origin xyz="0.1 0 0"/><mass value="0.5"/><inertia ixx="0.001" iyy="0.004" izz="0.004" ixy="0.0005" ixz="0" iyz="0"/></inertial>
    <collision><origin xyz="0.1 0 0"/><geometry><cylinder radius="0.02" length="0.2"/></geometry></collision></link>
  <joint name="j2" type="continuous"><parent link="l1"/><child link="l2"/><origin xyz="0.2 0 0"/><axis xyz="0 0 1"/></joint>
  <!-- fixed child (fusing) -->
  <link name="tool"><inertial><origin xyz="0.02 0 0"/><mass value="0.3"/><inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <joint name="jtool" type="fixed"><parent link="l2"/><child link="tool"/><origin xyz="0.2 0 0" rpy="0 0.5 0"/></joint>
  <!-- link with no inertial -->
  <link name="noinert"><collision><geometry><sphere radius="0.03"/></geometry></collision></link>
  <joint name="j3" type="prismatic"><parent link="tool"/><child link="noinert"/><origin xyz="0.05 0 0"/><axis xyz="1 0 0"/><limit lower="0" upper="0.1" effort="5" velocity="1"/></joint>
  <!-- mimic -->
  <link name="m1"><inertial><mass value="0.1"/><inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <joint name="jm" type="revolute"><parent link="l1"/><child link="m1"/><origin xyz="0.1 0.05 0"/><axis xyz="1 0 0"/><limit lower="-1" upper="1" effort="1" velocity="1"/><mimic joint="j1" multiplier="-1" offset="0"/></joint>
</robot>

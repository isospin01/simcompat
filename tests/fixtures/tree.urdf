<robot name="tree">
  <link name="pelvis"><inertial><mass value="5"/><inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <link name="L1"><inertial><origin xyz="0 0 -0.1"/><mass value="1"/><inertia ixx="0.01" iyy="0.01" izz="0.002" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <link name="L2"><inertial><origin xyz="0 0 -0.1"/><mass value="1"/><inertia ixx="0.01" iyy="0.01" izz="0.002" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <link name="R1"><inertial><origin xyz="0 0 -0.1"/><mass value="1"/><inertia ixx="0.01" iyy="0.01" izz="0.002" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <link name="R2"><inertial><origin xyz="0 0 -0.1"/><mass value="1"/><inertia ixx="0.01" iyy="0.01" izz="0.002" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <link name="T1"><inertial><origin xyz="0 0 0.1"/><mass value="2"/><inertia ixx="0.02" iyy="0.02" izz="0.004" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <joint name="left_hip" type="revolute"><parent link="pelvis"/><child link="L1"/><origin xyz="0 0.1 0"/><axis xyz="0 1 0"/><limit lower="-1" upper="1" effort="50" velocity="10"/></joint>
  <joint name="right_hip" type="revolute"><parent link="pelvis"/><child link="R1"/><origin xyz="0 -0.1 0"/><axis xyz="0 1 0"/><limit lower="-1" upper="1" effort="50" velocity="10"/></joint>
  <joint name="torso" type="revolute"><parent link="pelvis"/><child link="T1"/><origin xyz="0 0 0.1"/><axis xyz="0 0 1"/><limit lower="-1" upper="1" effort="50" velocity="10"/></joint>
  <joint name="left_knee" type="revolute"><parent link="L1"/><child link="L2"/><origin xyz="0 0 -0.2"/><axis xyz="0 1 0"/><limit lower="0" upper="2" effort="50" velocity="10"/></joint>
  <joint name="right_knee" type="revolute"><parent link="R1"/><child link="R2"/><origin xyz="0 0 -0.2"/><axis xyz="0 1 0"/><limit lower="0" upper="2" effort="50" velocity="10"/></joint>
</robot>

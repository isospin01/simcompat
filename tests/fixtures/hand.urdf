<?xml version="1.0"?>
<!-- Branches declared out of alphabetical order (like many hand/humanoid files).
     Depth-first in file order: index_*, thumb_*, middle_*; sorted by name: index_*, middle_*, thumb_*. -->
<robot name="hand">
  <link name="palm"><inertial><mass value="0.5"/><inertia ixx="1e-3" iyy="1e-3" izz="1e-3" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <link name="index_1"><inertial><origin xyz="0 0 0.02"/><mass value="0.05"/><inertia ixx="1e-5" iyy="1e-5" izz="5e-6" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <link name="index_2"><inertial><origin xyz="0 0 0.02"/><mass value="0.04"/><inertia ixx="1e-5" iyy="1e-5" izz="5e-6" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <link name="thumb_1"><inertial><origin xyz="0 0 0.02"/><mass value="0.06"/><inertia ixx="1e-5" iyy="1e-5" izz="5e-6" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <link name="middle_1"><inertial><origin xyz="0 0 0.02"/><mass value="0.05"/><inertia ixx="1e-5" iyy="1e-5" izz="5e-6" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <joint name="index_j1" type="revolute"><parent link="palm"/><child link="index_1"/><origin xyz="0.02 0 0.1"/><axis xyz="0 1 0"/><limit lower="-0.5" upper="1.5" effort="1" velocity="5"/></joint>
  <joint name="index_j2" type="revolute"><parent link="index_1"/><child link="index_2"/><origin xyz="0 0 0.04"/><axis xyz="0 1 0"/><limit lower="0" upper="1.5" effort="1" velocity="5"/></joint>
  <joint name="thumb_j1" type="revolute"><parent link="palm"/><child link="thumb_1"/><origin xyz="0.04 0.03 0.03" rpy="0 0 0.8"/><axis xyz="1 0 0"/><limit lower="-1" upper="1" effort="1" velocity="5"/></joint>
  <joint name="middle_j1" type="revolute"><parent link="palm"/><child link="middle_1"/><origin xyz="0 0 0.1"/><axis xyz="0 1 0"/><limit lower="-0.5" upper="1.5" effort="1" velocity="5"/></joint>
</robot>
